unit WebModuleUnit1;

interface

uses
  Winapi.ActiveX,
  System.SysUtils,
  System.Classes,
  Web.HTTPApp,
  Data.Win.ADODB;

type
  TWebModule1 = class(TWebModule)
    procedure WebModule1DefaultHandlerAction(Sender: TObject;
      Request: TWebRequest; Response: TWebResponse;
      var Handled: Boolean);
  private
    { Private declarations }
  public
    { Public declarations }
  end;

var
  WebModuleClass: TComponentClass = TWebModule1;

implementation

{%CLASSGROUP 'System.Classes.TPersistent'}

{$R *.dfm}

procedure TWebModule1.WebModule1DefaultHandlerAction(
  Sender: TObject;
  Request: TWebRequest;
  Response: TWebResponse;
  var Handled: Boolean);
var
  Connection: TADOConnection;
  Query: TADOQuery;
  CategoryQuery: TADOQuery;
  HTML: string;
begin

  Response.ContentType := 'text/html; charset=utf-8';

  Connection := TADOConnection.Create(nil);
  Query := TADOQuery.Create(nil);
  CategoryQuery := TADOQuery.Create(nil);

  try

    { Инициализация COM для ADO }
    CoInitialize(nil);


    { ПОДКЛЮЧЕНИЕ К SQL SERVER                   }


    Connection.LoginPrompt := False;

    Connection.ConnectionString :=
      'Provider=SQLOLEDB;' +
      'Data Source=.\SQLEXPRESS;' +
      'Initial Catalog=TechShopDB;' +
      'Integrated Security=SSPI;';

    Connection.Connected := True;


    { ЗАПРОС К ТАБЛИЦЕ PRODUCTS                  }


    Query.Connection := Connection;

    Query.SQL.Text :=
      'SELECT p.ProductName, p.Price, p.Description, ' +
      'c.CategoryName ' +
      'FROM Products p ' +
      'LEFT JOIN Categories c ON p.CategoryID = c.CategoryID ' +
      'ORDER BY p.ProductID';

    Query.Open;


    { HTML - НАЧАЛО СТРАНИЦЫ                     }

    HTML :=
      '<!DOCTYPE html>' +
      '<html lang="ru">' +

      '<head>' +
      '<meta charset="UTF-8">' +
      '<meta name="viewport" content="width=device-width, initial-scale=1.0">' +
      '<title>TechShop - магазин техники</title>' +

      '<style>' +

      'body {' +
      'margin: 0;' +
      'font-family: Arial, sans-serif;' +
      'background: #f4f6f8;' +
      'color: #222;' +
      '}' +

      'header {' +
      'background: #111827;' +
      'color: white;' +
      'padding: 20px 60px;' +
      'display: flex;' +
      'justify-content: space-between;' +
      'align-items: center;' +
      '}' +

      '.logo {' +
      'font-size: 28px;' +
      'font-weight: bold;' +
      '}' +

      'nav a {' +
      'color: white;' +
      'text-decoration: none;' +
      'margin-left: 25px;' +
      '}' +

      '.hero {' +
      'background: white;' +
      'padding: 60px 20px;' +
      'text-align: center;' +
      '}' +

      '.hero h1 {' +
      'font-size: 42px;' +
      'margin-bottom: 15px;' +
      '}' +

      '.hero p {' +
      'font-size: 18px;' +
      'color: #666;' +
      '}' +

      '.container {' +
      'max-width: 1100px;' +
      'margin: 40px auto;' +
      'padding: 0 20px;' +
      '}' +

      '.categories {' +
      'display: flex;' +
      'gap: 20px;' +
      'flex-wrap: wrap;' +
      '}' +

      '.category {' +
      'background: white;' +
      'padding: 25px;' +
      'border-radius: 10px;' +
      'flex: 1;' +
      'min-width: 150px;' +
      'text-align: center;' +
      'box-shadow: 0 2px 8px rgba(0,0,0,0.08);' +
      '}' +

      '.products {' +
      'display: grid;' +
      'grid-template-columns: repeat(3, 1fr);' +
      'gap: 20px;' +
      '}' +

      '.product {' +
      'background: white;' +
      'padding: 25px;' +
      'border-radius: 10px;' +
      'box-shadow: 0 2px 8px rgba(0,0,0,0.08);' +
      '}' +

      '.product h3 {' +
      'margin-top: 0;' +
      '}' +

      '.category-name {' +
      'display: inline-block;' +
      'background: #e5e7eb;' +
      'padding: 5px 10px;' +
      'border-radius: 5px;' +
      'font-size: 13px;' +
      'margin-bottom: 10px;' +
      '}' +

      '.price {' +
      'font-size: 22px;' +
      'font-weight: bold;' +
      'margin: 15px 0;' +
      'color: #e91e63;' +
      '}' +

      '.button {' +
      'display: inline-block;' +
      'background: #2563eb;' +
      'color: white;' +
      'padding: 10px 18px;' +
      'border-radius: 6px;' +
      'text-decoration: none;' +
      '}' +

      'footer {' +
      'margin-top: 50px;' +
      'background: #111827;' +
      'color: white;' +
      'text-align: center;' +
      'padding: 25px;' +
      '}' +

      '</style>' +
      '</head>' +

      '<body>' +

      '<header>' +
      '<div class="logo">TechShop</div>' +

      '<nav>' +
      '<a href="#">Главная</a>' +
      '<a href="#catalog">Каталог</a>' +
      '<a href="#categories">Категории</a>' +
      '<a href="#contacts">Контакты</a>' +
      '</nav>' +

      '</header>' +

      '<section class="hero">' +
      '<h1>Добро пожаловать в TechShop!</h1>' +
      '<p>Интернет-магазин современной техники</p>' +
      '</section>' +

      '<div class="container">' +

      '<h2 id="categories">Категории товаров</h2>' +

      '<div class="categories">';


    { ВЫВОД КАТЕГОРИЙ ИЗ SQL SERVER              }


    CategoryQuery.Connection := Connection;

    CategoryQuery.SQL.Text :=
      'SELECT CategoryName ' +
      'FROM Categories ' +
      'ORDER BY CategoryID';

    CategoryQuery.Open;

    while not CategoryQuery.Eof do
    begin

      HTML := HTML +

        '<div class="category">' +

        '<h3>' +
        CategoryQuery.FieldByName('CategoryName').AsString +
        '</h3>' +

        '<p>Товары данной категории</p>' +

        '</div>';

      CategoryQuery.Next;

    end;

    CategoryQuery.Close;

    HTML := HTML +

      '</div>' +

      '<h2 id="catalog" style="margin-top:40px;">Каталог товаров</h2>' +

      '<div class="products">';


    { ВЫВОД ТОВАРОВ ИЗ SQL SERVER                }


    while not Query.Eof do
    begin

      HTML := HTML +

        '<div class="product">' +

        '<span class="category-name">' +
        Query.FieldByName('CategoryName').AsString +
        '</span>' +

        '<h3>' +
        Query.FieldByName('ProductName').AsString +
        '</h3>' +

        '<p>' +
        Query.FieldByName('Description').AsString +
        '</p>' +

        '<div class="price">' +
        FormatFloat('#,##0', Query.FieldByName('Price').AsFloat) +
        ' ₸</div>' +

        '<a class="button" href="#">Подробнее</a>' +

        '</div>';

      Query.Next;

    end;


    { HTML - КОНЕЦ СТРАНИЦЫ                      }


    HTML := HTML +

      '</div>' +

      '</div>' +

      '<footer id="contacts">' +
      '<p>© 2026 TechShop - интернет-магазин техники</p>' +
      '</footer>' +

      '</body>' +
      '</html>';

    Response.Content := HTML;

    Handled := True;

  except

    on E: Exception do
    begin

      Response.Content :=
        '<html>' +
        '<head>' +
        '<meta charset="UTF-8">' +
        '<title>Ошибка</title>' +
        '</head>' +

        '<body>' +

        '<h1>Ошибка подключения к базе данных</h1>' +

        '<p>' +
        E.Message +
        '</p>' +

        '<hr>' +

        '<p>Проверьте подключение к SQL Server и базу TechShopDB.</p>' +

        '</body>' +
        '</html>';

      Handled := True;

    end;

  end;

  Query.Close;
  Query.Free;

  CategoryQuery.Free;

  Connection.Close;
  Connection.Free;

  CoUninitialize;

end;

end.
