    'color: #222;' +
    '}' +

    'header {' +
    'background: #111827;' +
    'color: white;' +
    'padding: 20px 60px;' +
    'display: flex;' +
    'justify-content: space-between;' +
    'align-items: center;' +
    '}' +

    '.logo {' +
    'font-size: 28px;' +
    'font-weight: bold;' +
    '}' +

    'nav a {' +
    'color: white;' +
    'text-decoration: none;' +
    'margin-left: 25px;' +
    '}' +

    '.hero {' +
    'background: white;' +
    'padding: 60px 20px;' +
    'text-align: center;' +
    '}' +

    '.hero h1 {' +
    'font-size: 42px;' +
    'margin-bottom: 15px;' +
    '}' +

    '.hero p {' +
    'font-size: 18px;' +
    'color: #666;' +
    '}' +

    '.container {' +
    'max-width: 1100px;' +
    'margin: 40px auto;' +
    'padding: 0 20px;' +
    '}' +

    '.categories {' +
    'display: flex;' +
    'gap: 20px;' +
    'flex-wrap: wrap;' +
    '}' +

    '.category {' +
    'background: white;' +
    'padding: 25px;' +
    'border-radius: 10px;' +
    'flex: 1;' +
    'min-width: 150px;' +
    'text-align: center;' +
    'box-shadow: 0 2px 8px rgba(0,0,0,0.08);' +
    '}' +

    '.products {' +
    'display: grid;' +
    'grid-template-columns: repeat(3, 1fr);' +
    'gap: 20px;' +
    '}' +

    '.product {' +
    'background: white;' +
    'padding: 25px;' +
    'border-radius: 10px;' +
    'box-shadow: 0 2px 8px rgba(0,0,0,0.08);' +
    '}' +

    '.product h3 {' +
    'margin-top: 0;' +
    '}' +

    '.price {' +
    'font-size: 22px;' +
    'font-weight: bold;' +
    'margin: 15px 0;' +
    '}' +

    '.button {' +
    'display: inline-block;' +
    'background: #2563eb;' +
    'color: white;' +
    'padding: 10px 18px;' +
    'border-radius: 6px;' +
    'text-decoration: none;' +
    '}' +

    'footer {' +
    'margin-top: 50px;' +
    'background: #111827;' +
    'color: white;' +
    'text-align: center;' +
    'padding: 25px;' +
    '}' +

    '</style>' +

    '</head>' +

    '<body>' +

    '<header>' +
    '<div class="logo">TechShop</div>' +
    '<nav>' +
    '<a href="#">Главная</a>' +
    '<a href="#">Каталог</a>' +
    '<a href="#">Категории</a>' +
    '<a href="#">Контакты</a>' +
    '</nav>' +
    '</header>' +

    '<section class="hero">' +
    '<h1>Добро пожаловать в TechShop!</h1>' +
