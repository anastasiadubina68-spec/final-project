    '<a class="button" href="#">Подробнее</a>' +
    '</div>' +

    '<div class="product">' +
    '<h3>ASUS VivoBook 15</h3>' +
    '<p>Ноутбук для работы и учёбы</p>' +
    '<div class="price">380 000 ₸</div>' +
    '<a class="button" href="#">Подробнее</a>' +
    '</div>' +

    '<div class="product">' +
    '<h3>Sony WH-1000XM5</h3>' +
    '<p>Беспроводные наушники</p>' +
    '<div class="price">180 000 ₸</div>' +
    '<a class="button" href="#">Подробнее</a>' +
    '</div>' +

