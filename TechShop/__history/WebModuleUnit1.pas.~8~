unit WebModuleUnit1;

interface

uses
  Winapi.ActiveX,
  System.SysUtils,
  System.Classes,
  Web.HTTPApp,
  Data.Win.ADODB;

type
  TWebModule1 = class(TWebModule)
    procedure WebModule1DefaultHandlerAction(
      Sender: TObject;
      Request: TWebRequest;
      Response: TWebResponse;
      var Handled: Boolean);
  private
  public
  end;

var
  WebModuleClass: TComponentClass = TWebModule1;

implementation

{%CLASSGROUP 'System.Classes.TPersistent'}

{$R *.dfm}

procedure TWebModule1.WebModule1DefaultHandlerAction(
  Sender: TObject;
  Request: TWebRequest;
  Response: TWebResponse;
  var Handled: Boolean);

var
  Connection: TADOConnection;
  Query: TADOQuery;
  HTML: string;

begin

  Response.ContentType := 'text/html; charset=utf-8';

  Connection := TADOConnection.Create(nil);
  Query := TADOQuery.Create(nil);

  try

    CoInitialize(nil);

    { ========================================== }
    { ПОДКЛЮЧЕНИЕ К SQL SERVER                   }
    { ========================================== }

    Connection.LoginPrompt := False;

    Connection.ConnectionString :=
      'Provider=SQLOLEDB;' +
      'Data Source=.\SQLEXPRESS;' +
      'Initial Catalog=TechShopDB;' +
      'Integrated Security=SSPI;';

    Connection.Connected := True;

    { ========================================== }
    { ЗАПРОС ТОВАРОВ И КАТЕГОРИЙ                 }
    { ========================================== }

    Query.Connection := Connection;

    Query.SQL.Text :=
      'SELECT ' +
      'p.ProductID, ' +
      'p.ProductName, ' +
      'p.Price, ' +
      'p.Description, ' +
      'p.CategoryID, ' +
      'c.CategoryName ' +
      'FROM Products p ' +
      'LEFT JOIN Categories c ON p.CategoryID = c.CategoryID ' +
      'ORDER BY p.ProductID';

    Query.Open;

    { ========================================== }
    { HTML-СТРАНИЦА                              }
    { ========================================== }

    HTML :=
      '<!DOCTYPE html>' +
      '<html lang="ru">' +

      '<head>' +

      '<meta charset="UTF-8">' +

      '<meta name="viewport" ' +
      'content="width=device-width, initial-scale=1.0">' +

      '<title>TechShop - интернет-магазин техники</title>' +

      '<style>' +

      '* {' +
      'box-sizing: border-box;' +
      '}' +

      'html {' +
      'scroll-behavior: smooth;' +
      '}' +

      'body {' +
      'margin: 0;' +
      'font-family: Arial, sans-serif;' +
      'background: #f4f6f8;' +
      'color: #222;' +
      '}' +

      'header {' +
      'background: #111827;' +
      'color: white;' +
      'padding: 20px 60px;' +
      'display: flex;' +
      'justify-content: space-between;' +
      'align-items: center;' +
      'position: sticky;' +
      'top: 0;' +
      'z-index: 1000;' +
      '}' +

      '.logo {' +
      'font-size: 28px;' +
      'font-weight: bold;' +
      '}' +

      'nav {' +
      'display: flex;' +
      'gap: 25px;' +
      '}' +

      'nav a {' +
      'color: white;' +
      'text-decoration: none;' +
      'cursor: pointer;' +
      'font-size: 16px;' +
      '}' +

      'nav a:hover {' +
      'color: #60a5fa;' +
      '}' +

      '.hero {' +
      'background: white;' +
      'padding: 70px 20px;' +
      'text-align: center;' +
      '}' +

      '.hero h1 {' +
      'font-size: 42px;' +
      'margin: 0 0 15px 0;' +
      '}' +

      '.hero p {' +
      'font-size: 19px;' +
      'color: #666;' +
      '}' +

      '.container {' +
      'max-width: 1100px;' +
      'margin: 40px auto;' +
      'padding: 0 20px;' +
      '}' +

      'h2 {' +
      'font-size: 28px;' +
      'margin-bottom: 25px;' +
      '}' +

      '.categories {' +
      'display: grid;' +
      'grid-template-columns: repeat(5, 1fr);' +
      'gap: 15px;' +
      '}' +

      '.category {' +
      'background: white;' +
      'padding: 25px 15px;' +
      'border-radius: 12px;' +
      'text-align: center;' +
      'box-shadow: 0 2px 8px rgba(0,0,0,0.08);' +
      'transition: 0.2s;' +
      'cursor: pointer;' +
      'border: none;' +
      'width: 100%;' +
      '}' +

      '.category:hover {' +
      'transform: translateY(-4px);' +
      'box-shadow: 0 5px 15px rgba(0,0,0,0.15);' +
      '}' +

      '.category h3 {' +
      'margin: 0 0 12px 0;' +
      'font-size: 18px;' +
      '}' +

      '.category p {' +
      'margin: 0;' +
      'color: #2563eb;' +
      '}' +

      '.all-products {' +
      'display: inline-block;' +
      'margin-bottom: 25px;' +
      'background: #111827;' +
      'color: white;' +
      'padding: 10px 18px;' +
      'border-radius: 7px;' +
      'border: none;' +
      'cursor: pointer;' +
      'font-size: 15px;' +
      '}' +

      '.all-products:hover {' +
      'background: #374151;' +
      '}' +

      '.products {' +
      'display: grid;' +
      'grid-template-columns: repeat(3, 1fr);' +
      'gap: 20px;' +
      '}' +

      '.product {' +
      'background: white;' +
      'padding: 25px;' +
      'border-radius: 12px;' +
      'box-shadow: 0 2px 8px rgba(0,0,0,0.08);' +
      '}' +

      '.product h3 {' +
      'margin-top: 0;' +
      'font-size: 20px;' +
      '}' +

      '.product-category {' +
      'font-size: 14px;' +
      'color: #2563eb;' +
      'margin-bottom: 10px;' +
      '}' +

      '.product-description {' +
      'color: #666;' +
      'min-height: 45px;' +
      '}' +

      '.price {' +
      'font-size: 22px;' +
      'font-weight: bold;' +
      'margin: 15px 0;' +
      'color: #e91e63;' +
      '}' +

      '.button {' +
      'display: inline-block;' +
      'background: #2563eb;' +
      'color: white;' +
      'padding: 10px 18px;' +
      'border-radius: 6px;' +
      'border: none;' +
      'text-decoration: none;' +
      'cursor: pointer;' +
      '}' +

      '.button:hover {' +
      'background: #1d4ed8;' +
      '}' +

      '.no-products {' +
      'background: white;' +
      'padding: 30px;' +
      'border-radius: 10px;' +
      'text-align: center;' +
      'color: #666;' +
      '}' +

      'footer {' +
      'margin-top: 70px;' +
      'background: #111827;' +
      'color: white;' +
      'text-align: center;' +
      'padding: 30px;' +
      '}' +

      '@media (max-width: 900px) {' +
      '.categories {' +
      'grid-template-columns: repeat(2, 1fr);' +
      '}' +

      '.products {' +
      'grid-template-columns: repeat(2, 1fr);' +
      '}' +

      'header {' +
      'padding: 20px;' +
      '}' +
      '}' +

      '@media (max-width: 600px) {' +
      '.categories {' +
      'grid-template-columns: 1fr;' +
      '}' +

      '.products {' +
      'grid-template-columns: 1fr;' +
      '}' +

      'nav {' +
      'gap: 10px;' +
      '}' +

      'nav a {' +
      'font-size: 13px;' +
      '}' +

      '.hero h1 {' +
      'font-size: 30px;' +
      '}' +
      '}' +

      '</style>' +

      '</head>' +

      '<body>' +

      { ========================================== }
      { ШАПКА }
      { ========================================== }

      '<header id="home">' +

      '<div class="logo">TechShop</div>' +

      '<nav>' +

      '<a href="#home">Главная</a>' +

      '<a href="#catalog">Каталог</a>' +

      '<a href="#categories">Категории</a>' +

      '<a href="#contacts">Контакты</a>' +

      '</nav>' +

      '</header>' +

      { ========================================== }
      { ГЛАВНЫЙ БЛОК }
      { ========================================== }

      '<section class="hero">' +

      '<h1>Добро пожаловать в TechShop!</h1>' +

      '<p>Интернет-магазин современной техники</p>' +

      '</section>' +

      '<div class="container">' +

      { ========================================== }
      { КАТЕГОРИИ }
      { ========================================== }

      '<h2 id="categories">Категории товаров</h2>' +

      '<div class="categories">' +

      '<button class="category" ' +
      'onclick="filterProducts(''Смартфоны'')">' +
      '<h3>📱 Смартфоны</h3>' +
      '<p>Посмотреть товары</p>' +
      '</button>' +

      '<button class="category" ' +
      'onclick="filterProducts(''Ноутбуки'')">' +
      '<h3>💻 Ноутбуки</h3>' +
      '<p>Посмотреть товары</p>' +
      '</button>' +

      '<button class="category" ' +
      'onclick="filterProducts(''Планшеты'')">' +
      '<h3>📱 Планшеты</h3>' +
      '<p>Посмотреть товары</p>' +
      '</button>' +

      '<button class="category" ' +
      'onclick="filterProducts(''Наушники'')">' +
      '<h3>🎧 Наушники</h3>' +
      '<p>Посмотреть товары</p>' +
      '</button>' +

      '<button class="category" ' +
      'onclick="filterProducts(''Телевизоры'')">' +
      '<h3>📺 Телевизоры</h3>' +
      '<p>Посмотреть товары</p>' +
      '</button>' +

      '</div>' +

      { ========================================== }
      { КАТАЛОГ }
      { ========================================== }

      '<h2 id="catalog" style="margin-top:50px;">Каталог товаров</h2>' +

      '<button class="all-products" onclick="showAllProducts()">' +
      'Показать все товары' +
      '</button>' +

      '<div class="products" id="productList">';

    { ========================================== }
    { ТОВАРЫ ИЗ SQL SERVER }
    { ========================================== }

    while not Query.Eof do
    begin

      HTML := HTML +

        '<div class="product" ' +
        'data-category="' +
        Query.FieldByName('CategoryName').AsString +
        '">' +

        '<div class="product-category">' +
        Query.FieldByName('CategoryName').AsString +
        '</div>' +

        '<h3>' +
        Query.FieldByName('ProductName').AsString +
        '</h3>' +

        '<p class="product-description">' +
        Query.FieldByName('Description').AsString +
        '</p>' +

        '<div class="price">' +
        FormatFloat('#,##0',
          Query.FieldByName('Price').AsFloat) +
        ' ₸' +
        '</div>' +

        '<button class="button" ' +
        'onclick="showProduct(''' +
        StringReplace(
          Query.FieldByName('ProductName').AsString,
          '''',
          '\''',
          [rfReplaceAll]
        ) +
        ''')">' +
        'Подробнее' +
        '</button>' +

        '</div>';

      Query.Next;

    end;

    HTML := HTML +

      '</div>' +

      '</div>' +

      { ========================================== }
      { FOOTER }
      { ========================================== }

      '<footer id="contacts">' +

      '<h3>TechShop</h3>' +

      '<p>Интернет-магазин современной техники</p>' +

      '<p>© 2026 TechShop. Все права защищены.</p>' +

      '</footer>' +

      { ========================================== }
      { JAVASCRIPT }
      { ========================================== }

      '<script>' +

      'function filterProducts(category) {' +

      'var products = document.querySelectorAll(".product");' +

      'var found = false;' +

      'products.forEach(function(product) {' +

      'if (product.getAttribute("data-category") === category) {' +
      'product.style.display = "block";' +
      'found = true;' +
      '} else {' +
      'product.style.display = "none";' +
      '}' +

      '});' +

      'document.getElementById("catalog").scrollIntoView({' +
      'behavior: "smooth"' +
      '});' +

      '}' +

      'function showAllProducts() {' +

      'var products = document.querySelectorAll(".product");' +

      'products.forEach(function(product) {' +
      'product.style.display = "block";' +
      '});' +

      'document.getElementById("catalog").scrollIntoView({' +
      'behavior: "smooth"' +
      '});' +

      '}' +

      'function showProduct(name) {' +

      'alert("Товар: " + name + "\\n\\nДля оформления заказа свяжитесь с нами.");' +

      '}' +

      '</script>' +

      '</body>' +

      '</html>';

    Response.Content := HTML;

    Handled := True;

  except

    on E: Exception do
    begin

      Response.ContentType := 'text/html; charset=utf-8';

      Response.Content :=

        '<html>' +

        '<head>' +
        '<meta charset="UTF-8">' +
        '<title>Ошибка</title>' +
        '</head>' +

        '<body style="font-family:Arial;padding:40px;">' +

        '<h1>Ошибка подключения к базе данных</h1>' +

        '<p>' + E.Message + '</p>' +

        '<hr>' +

        '<p>' +
        'Проверьте подключение к SQL Server, таблицы Products и Categories.' +
        '</p>' +

        '</body>' +

        '</html>';

      Handled := True;

    end;

  end;

  Query.Close;
  Query.Free;

  Connection.Close;
  Connection.Free;

  CoUninitialize;

end;

end.
